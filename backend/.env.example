NODE_ENV=production
PORT=3000

# Frontend origin
APP_ORIGIN=https://your-frontend-domain.example

# MySQL credentials: replace with values from your hosting control panel
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=CHANGE_ME

# Generate a unique random secret (at least 32 bytes)
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Private URL of the Python crystallography service
SPGLIB_URL=http://127.0.0.1:8100
